---
whiskers:
  version: "^2.9.0"
  matrix:
    - output: ["palette"]
  filename: "packages/catppuccin-tailwindcss/src/_palette.scss"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
// Generated by Whiskers from tailwindcss.tera. Do not edit directly.

$palette: (
{% for flavor_id in ["latte", "frappe", "macchiato", "mocha"] %}  "{{ flavor_id }}": (
{% for color_id in ["base", "blue", "crust", "flamingo", "green", "lavender", "mantle", "maroon", "mauve", "overlay0", "overlay1", "overlay2", "peach", "pink", "red", "rosewater", "sapphire", "sky", "subtext0", "subtext1", "surface0", "surface1", "surface2", "teal", "text", "yellow"] %}    "{{ color_id }}": {{ flavors[flavor_id].colors[color_id].hex }}{% if not loop.last %},{% endif %}
{% endfor %}  ){% if not loop.last %},{% endif %}
{% endfor %});
