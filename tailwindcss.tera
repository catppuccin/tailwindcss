---
whiskers:
  version: "^2.9.0"
  filename: "packages/catppuccin-tailwindcss/src/_palette.scss"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
// Generated by Whiskers from tailwindcss.tera. Do not edit directly.

$palette: (
{%- for flavor_id in ["latte", "frappe", "macchiato", "mocha"] %}
  "{{ flavor_id }}": (
  {%- for color_id, color in flavors[flavor_id].colors %}
    "{{ color_id }}": {{ color.hex }}{%- if not loop.last %},{% endif %}
  {%- endfor %}
  ){%- if not loop.last %},{% endif %}
{%- endfor %}
);
